@page "/"
@rendermode InteractiveAuto

<PageTitle>Inicio - Simu</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1>Bienvenido a Simu</h1>
            <p class="lead">Sistema de Gestión de Motocicletas, Transacciones y Reparaciones</p>
            
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="fas fa-motorcycle"></i> Motos
                            </h5>
                            <p class="card-text">Gestiona el inventario de motocicletas</p>
                            <a href="/motos" class="btn btn-primary">Ir a Motos</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="fas fa-box"></i> Productos
                            </h5>
                            <p class="card-text">Administra productos y accesorios</p>
                            <a href="/productos" class="btn btn-primary">Ir a Productos</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="fas fa-exchange-alt"></i> Transacciones
                            </h5>
                            <p class="card-text">Consulta y crea transacciones</p>
                            <a href="/transacciones" class="btn btn-primary">Ir a Transacciones</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
